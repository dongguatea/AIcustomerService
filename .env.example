# 聊天上游。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx
# DeepSeek 默认思考模式不支持结构化输出的 tool_choice,这里用 disabled;
# 换到 OpenAI 等其他家时留空(不发送 thinking 参数)。
CHAT_THINKING=disabled

TOKEN_BUDGET=2000
TOOL_TIMEOUT=10.0
TOOL_MAX_RETRIES=2
RAG_TOOL_TIMEOUT=30.0

# 本地 MySQL(默认值已对齐 docker-compose,可留空)
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp@127.0.0.1:3307/mewhelp?charset=utf8mb4

# ch03 知识库嵌入(BGE-M3,硅基流动 OpenAI 兼容;验收前把 EMBED_API_KEY 填成真实值)
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=sk-xxx

# Milvus Standalone(Docker etcd+minio+milvus)
MILVUS_URI=http://localhost:19530
DENSE_TOP_K=5
DENSE_MIN_SCORE=0.40

# ch04 重排(bge-reranker-v2-m3)。BASE_URL 有内置默认值(硅基流动),换上游才需取消注释
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ch04 混合检索 + 重排
RECALL_TOP_K=50
RERANK_TOP_K=10
RERANK_MIN_SCORE=0.30
