# 聊天上游。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx
# DeepSeek 默认思考模式不支持结构化输出的 tool_choice,这里用 disabled;
# 换到 OpenAI 等其他家时留空(不发送 thinking 参数)。
CHAT_THINKING=disabled

TOKEN_BUDGET=2000

# 本地 MySQL(默认值已对齐 docker-compose,可留空)
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp@127.0.0.1:3306/mewhelp
TOOL_TIMEOUT=10.0
TOOL_MAX_RETRIES=2
